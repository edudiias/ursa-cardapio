{
  "name": "ursa-cardapio",
  "version": "1.1.0",
  "private": true,
  "description": "Cardápio estático e editor local do Ursa Bar",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node --test tests/browser.cjs tests/persistence.cjs tests/publishing.cjs",
    "worker:dev": "wrangler dev --config backend/wrangler.jsonc",
    "worker:check": "wrangler deploy --dry-run --config backend/wrangler.jsonc --outdir ../test-results/worker-build",
    "test:runtime": "node --test tests/runtime.cjs"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "wrangler": "4.156.0"
  }
}
