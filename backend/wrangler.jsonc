{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ursa-cardapio-publicacao",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "AUTH_STORE", "class_name": "AuthStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AuthStore"] }],
  "vars": {
    "BACKEND_ORIGIN": "https://ursa-cardapio-publicacao.SUA-SUBCONTA.workers.dev",
    "EDITOR_ORIGIN": "https://edudiias.github.io",
    "GITHUB_CLIENT_ID": "PREENCHA_O_CLIENT_ID_DA_GITHUB_APP",
    "PUBLISH_ENABLED": "false"
  },
  "observability": { "enabled": false }
}
